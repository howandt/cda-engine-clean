{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "Cache-Control", "value": "s-maxage=3600, stale-while-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/cdf/core.js": {
      "includeFiles": "public/CDF/data/**"
    },
    "api/emotion-engine.js": {
      "includeFiles": "public/CDA/data/**"
    },
    "api/pbl-projects.js": {
      "includeFiles": "public/CDA/data/**"
    },
    "api/cdt/diagnoser.js": {
      "includeFiles": "public/CDT/data/**"
    },
    "api/cdt/specialister.js": {
      "includeFiles": "public/CDT/data/**"
    },
    "api/cdt/templates.js": {
      "includeFiles": "public/CDT/data/**"
    },
    "api/cdt/rollespil.js": {
      "includeFiles": "public/CDT/data/**"
    },
    "api/cdt/quiz.js": {
      "includeFiles": "public/CDT/data/**"
    },
    "api/cdt/emotionmotor.js": {
      "includeFiles": "public/CDT/data/**"
    },
    "api/cdt/pbl-projekter.js": {
      "includeFiles": "public/CDT/data/**"
    },
    "api/cdt/semantic-engine.js": {
      "includeFiles": "public/CDT/data/**"
    },
    "api/cdt/cases.js": {
      "includeFiles": "public/CDT/data/**"
    }
  }
}