{
  "version": "2.0.0",
  "description": "Semantisk motor til CDA – forbinder naturlige forespørgsler med datafelter i CDA_Cases_Index_clean.json + Konflikt-Mediator",

  "intents": {
    "find_case": {
      "examples": [
        "find en case om [diagnose]",
        "vis mig en case om [tema]",
        "har du en case fra [miljø]",
        "jeg søger en case med et barn der [adfærd]"
      ],
      "maps_to": "/api/cases"
    },
    "find_quiz": {
      "examples": [
        "lav en quiz om [diagnose]",
        "find en quiz til [tema]",
        "jeg vil teste viden om [diagnose]"
      ],
      "maps_to": "/api/quiz"
    },
    "find_template": {
      "examples": [
        "lav en støtteplan for [diagnose]",
        "vis en handleplan til [tema]",
        "jeg skal bruge en skabelon til [miljø]"
      ],
      "maps_to": "/api/templates"
    },
    "find_rollespil": {
      "examples": [
        "lav et rollespil om [tema]",
        "vis en dialog mellem lærer og barn med [diagnose]"
      ],
      "maps_to": "/api/rollespil"
    },
    "resolve_conflict": {
      "examples": [
        "skole og hjem er uenige om [emne]",
        "lærer mener [X] men forælder mener [Y]",
        "vi kan ikke blive enige om hvad der er bedst for barnet",
        "forælderen forstår ikke dansk skole",
        "læreren vil ikke lytte til os",
        "vi har problemer med samarbejdet mellem skole og hjem",
        "skolen gør ikke hvad de lovede",
        "vi ser meget forskelligt på barnets behov"
      ],
      "maps_to": "/api/conflict-mediator"
    }
  },

