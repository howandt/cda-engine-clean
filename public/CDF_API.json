{
  "openapi": "3.1.0",
  "info": {
    "title": "CDF Engine API",
    "version": "1.0.0",
    "description": "API til CDF-systemet – henter data fra public/CDF/data via Vercel. Giver adgang til Sarahs personlighed, følelser, livsmoduler og støttesystemer."
  },
  "servers": [
    {
      "url": "https://cda-engine-clean.vercel.app",
      "description": "CDF dataserver (Vercel)"
    }
  ],
  "paths": {
    "/api/cdf": {
      "get": {
        "operationId": "getCdfModule",
        "summary": "Hent et CDF-modul",
        "description": "Henter CDF_Core eller et modul fra public/CDF/data. Alle moduler tilgås via ?module=<navn> (små bogstaver). Brug 'list' for at se tilgængelige moduler.",
        "parameters": [
          {
            "name": "module",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "core",
                "emotions",
                "foodlab",
                "healthlab",
                "recipesandhealth",
                "sociallab",
                "sleeplab",
                "movelab",
                "adaptcore",
                "carelab",
                "carmspace",
                "greenlab",
                "growlab",
                "hjemmeterapi",
                "hobbylab",
                "lifeflow",
                "lifetools",
                "memorylab",
                "pblprojects",
                "purposelab",
                "pushsupport",
                "crisisupport",
                "specialistsupport",
                "supportlab",
                "welcome",
                "list"
              ],
              "example": "core",
              "description": "Modulnavn (små bogstaver). Brug 'list' for oversigt over alle moduler."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succes – moduldata returneret",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Om forespørgslen lykkedes"
                    },
                    "module": {
                      "type": "string",
                      "description": "Navnet på det hentede modul"
                    },
                    "data": {
                      "type": "object",
                      "description": "Modulets indhold - varierer efter modul"
                    },
                    "modules": {
                      "type": "array",
                      "description": "Liste over tilgængelige moduler (kun ved ?module=list)",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Fejl – manglende eller ugyldig modulparameter",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Serverfejl – modulfil ikke fundet eller ugyldig",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}