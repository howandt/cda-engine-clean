{
  "openapi": "3.1.0",
  "info": {
    "title": "CDF Engine API",
    "version": "1.0.0",
    "description": "API til CDF-systemet – henter data fra public/CDF/Core og public/CDF/data via Vercel."
  },
  "servers": [
    {
      "url": "https://cda-engine-clean.vercel.app",
      "description": "CDF dataserver (Vercel)"
    }
  ],
  "paths": {
    "/api/cdf": {
      "get": {
        "operationId": "getCdfModule",
        "summary": "Hent et CDF-modul",
        "description": "Henter CDF_Core eller et modul fra public/CDF/data ved brug af ?module=<navn>.",
        "parameters": [
          {
            "name": "module",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "core"
            },
            "description": "Navn på det modul, der skal hentes – fx core, food, health, recipes eller list"
          }
        ],
        "responses": {
          "200": {
            "description": "Succes – moduldata returneret",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "module": { "type": "string" },
                    "data": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Fejl – manglende eller ugyldig modulparameter"
          },
          "500": {
            "description": "Serverfejl – modulfil ikke fundet eller ugyldig"
          }
        }
      }
    },
    "/api/emotion-engine": {
      "post": {
        "operationId": "analyzeEmotion",
        "summary": "Analyser kommunikation",
        "description": "Analyserer tekst for følelsesmæssig tone",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Teksten der skal analyseres"
                  }
                },
                "required": ["text"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Succes – følelsesanalyse returneret",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "analysis": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Fejl – manglende tekst parameter"
          },
          "500": {
            "description": "Serverfejl"
          }
        }
      }
    }
  }
}